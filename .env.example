# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Telegram bot token (@BotFather). Web UI works without it.
TELEGRAM_BOT_TOKEN=

# Optional overrides
# Comma-separated Gemini model fallback chain (503/429 -> next model + retry with backoff)
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite
# Path to the SQLite database (built by etl.py)
UZEX_DB_PATH=uzex.db
# Path to the folder with CSV files (deals_2022.csv ... usd_rates.csv)
UZEX_DATA_DIR=uzex_spot_data
# Web server
HOST=0.0.0.0
PORT=8000
